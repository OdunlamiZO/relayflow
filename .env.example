# RelayFlow production self-hosting configuration.
# Copy this file to `.env` and fill in the values below, then run:
#   docker compose --profile prod up -d
# See docs/self-hosting.md for the full walkthrough.

# ── Domains (used by Caddy for automatic TLS — point DNS here first) ──────────
RELAYFLOW_WEB_DOMAIN=app.example.com
RELAYFLOW_API_DOMAIN=api.example.com

# ── Public service URLs (full https:// URLs, no trailing slash) ──────────────
# Web app address: CORS origin, invite links, redirect after login, Google redirect URI.
RELAYFLOW_WEB_BASE_URL=https://app.example.com
# API address: the webhook URLs Telegram and WhatsApp call.
RELAYFLOW_API_BASE_URL=https://api.example.com

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=relayflow
POSTGRES_USER=relayflow
POSTGRES_PASSWORD=                     # REQUIRED, no default — generate: openssl rand -base64 24

# ── Security (REQUIRED, no safe default) ───────────────────────────────────
RELAYFLOW_ENCRYPTION_KEY=              # REQUIRED — generate: openssl rand -base64 32
                                        # The API refuses to start without this.

# ── Session cookies ─────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=JSESSIONID
SESSION_COOKIE_SECURE=true             # must be true — Caddy terminates TLS
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT=30m

# ── Google OAuth (optional) ─────────────────────────────────────────────────
# Authorized redirect URI to add in Google Cloud:
#   <RELAYFLOW_WEB_BASE_URL>/backend/login/oauth2/code/google
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM providers (optional — at least one needed for AI agent features) ───
ANTHROPIC_API_KEY=
# OpenAI-compatible: any API that speaks OpenAI's chat completions format. The base URL includes /v1, for example
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://<ollama-host>:11434/v1   (no key needed)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# The model is set in Redis, not here — see docs/self-hosting.md:
#   redis-cli SET platform:llm:openai-compatible:model llama-3.3-70b-versatile

# ── Email — SMTP (optional; blank host = no-op/log mode) ────────────────────
# Works with any provider: Resend, SES, Mailgun, Postmark, Gmail, self-hosted, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=RelayFlow <noreply@example.com>

# ── Rate limiting (optional — all have safe defaults) ───────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_SIGNUP_LIMIT=10
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
RATE_LIMIT_PUBLIC_API_LIMIT=60
RATE_LIMIT_PUBLIC_API_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_LIMIT=120
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60

# ── Timeouts & retention (optional — safe defaults) ─────────────────────────
RELAYFLOW_HTTP_CONNECT_TIMEOUT_MS=10000
RELAYFLOW_HTTP_READ_TIMEOUT_MS=20000
RELAYFLOW_WEBHOOK_TIMEOUT_MS=10000
RELAYFLOW_INVITE_EXPIRY_DAYS=7
WORKFLOW_RUN_RETENTION_DAYS=90
AGENT_INVOCATION_LOG_RETENTION_DAYS=90

# ── Logging (optional) ──────────────────────────────────────────────────────
# json (Datadog and most agents), ecs (Elastic), gelf (Graylog), logfmt (Loki), or text (human-readable).
LOG_FORMAT=json
# Log level for RelayFlow code (DEBUG includes personal data such as email addresses).
LOG_LEVEL=INFO

# ── JVM (optional) ──────────────────────────────────────────────────────────
# Extra flags for the API's JVM. By default the heap may use 75% of the API
# container's memory limit (1g in docker-compose.yml) — raise that limit for
# heavier workloads rather than setting -Xmx here.
# JAVA_OPTS=-XX:MaxRAMPercentage=75

# ── Misc ─────────────────────────────────────────────────────────────────────
RELAYFLOW_VERSION=latest               # image tag to pull/build — pin to a release tag in production
