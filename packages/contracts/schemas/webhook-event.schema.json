{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relayflow.local/schemas/webhook-event.schema.json",
  "title": "WorkspaceWebhookEvent",
  "description": "Payload delivered to a workspace-configured webhook endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "timestamp", "workspaceId", "data"],
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "contact.created",
        "contact.updated",
        "contact.deleted",
        "contact.merged"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "contact.created" } } },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/contactCreatedData" } }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "enum": ["contact.updated", "contact.deleted"] }
        }
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/contactSnapshotData" } }
      }
    },
    {
      "if": { "properties": { "event": { "const": "contact.merged" } } },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/contactMergedData" } }
      }
    }
  ],
  "$defs": {
    "contactCreatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact", "channel"],
      "properties": {
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "displayName"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "displayName": {
              "type": "string"
            },
            "username": {
              "type": "string"
            }
          }
        },
        "channel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "provider"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "enum": ["TELEGRAM", "WHATSAPP"]
            }
          }
        }
      }
    },
    "contactSnapshotData": {
      "description": "contact.updated: the contact after the change. contact.deleted: the contact just before deletion.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contact"],
      "properties": {
        "contact": { "$ref": "#/$defs/contactSnapshot" }
      }
    },
    "contactMergedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact", "mergedContact"],
      "properties": {
        "contact": {
          "description": "The kept contact.",
          "$ref": "#/$defs/contactSnapshot"
        },
        "mergedContact": {
          "description": "The contact merged into it and deleted, as it was before the merge.",
          "$ref": "#/$defs/contactSnapshot"
        }
      }
    },
    "contactSnapshot": {
      "description": "Custom field values are flattened onto the object alongside id and displayName.",
      "type": "object",
      "required": ["id", "displayName", "tags"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "displayName": {
          "type": "string"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
