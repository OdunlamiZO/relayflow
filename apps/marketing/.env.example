# ── API ───────────────────────────────────────────────────────────────────────
# Used by the "See it live" button to create a guest session.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── App ───────────────────────────────────────────────────────────────────────
# Base URL of the RelayFlow app (apps/web) — where "Log in", "Get started", and
# "See it live" send visitors.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
