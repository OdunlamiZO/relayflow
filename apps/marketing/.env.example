# ── Database ─────────────────────────────────────────────────────────────────
MARKETING_DB_PATH=./data/marketing.sqlite

# ── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
PAYSTACK_PRICE_MINOR_UNITS=            # flat one-time price, in the currency's minor unit

# ── License terms ────────────────────────────────────────────────────────────
LICENSE_TERM_DAYS=365

# ── License signing key (server secret — never given to customers) ───────────
# generate via scripts/generate-license-keypair.mjs. The matching public key
# is NOT set here — it goes in the RELAYFLOW_LICENSE_SIGNING_PUBLIC_KEY GitHub
# Actions secret, baked into relayflow-api images at build time (see
# docker-publish.yml and apps/api/LicenseKeyValidator).
LICENSE_SIGNING_PRIVATE_KEY_B64=

# ── Email — Resend (optional; blank = no-op/log mode) ─────────────────────────
RESEND_API_KEY=
RESEND_FROM=RelayFlow <licenses@relayflow.io>

# ── Telegram (required — sale notifications that gate license delivery) ──────
# A paid order sits in "awaiting_access_grant" until this notification is acted
# on (see apps/marketing/README.md) — without it, orders never complete.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Deployment ──────────────────────────────────────────────────────────────
MARKETING_BASE_URL=http://localhost:4000   # used to build Paystack's callback_url

# ── Rate limiting ───────────────────────────────────────────────────────────
CHECKOUT_RATE_LIMIT=5
CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=3600
